# Copy this file to .env (in the repo root) and fill in your SLOPE API credentials.
# .env is git-ignored - never commit it or share real key values.
# To switch tenants, edit .env or set SLOPE_ENV_FILE to the path of a different env file.
SLOPE_API_KEY=
SLOPE_API_SECRET=

# Optional: override local working folders (default to folders under your home directory)
# SLOPE_WORKING_DIR=
# SLOPE_REPORTS_DIR=
