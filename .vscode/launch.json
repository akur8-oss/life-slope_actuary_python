{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "SBA Solver Module",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/SBA_Solver",
            "python": "${workspaceFolder}/SBA_Solver/.venv/bin/python",
            "args": ["${input:sbaRunFile}"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/SBA_Solver"
            },
        },
        {
            "name": "PBR Solver Module",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/PBR_Solver",
            "python": "${workspaceFolder}/PBR_Solver/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/PBR_Solver"
            },
        }
    ],
    "inputs": [
        {
            // SBA solver run file, relative to the SBA_Solver folder. Copy runs/example.toml to create one
            "id": "sbaRunFile",
            "type": "promptString",
            "description": "SBA solver run file (relative to SBA_Solver)",
            "default": "runs/run.toml"
        }
    ]
}